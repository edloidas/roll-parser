{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/render.ts", "src/testing.ts"],
  "tsconfig": "tsconfig.json",
  "out": "site/dist/docs",
  "name": "roll-parser",
  "readme": "README.md",
  "includeVersion": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "visibilityFilters": {
    "inherited": true
  },
  "categorizeByGroup": false,
  "categoryOrder": ["Core", "Results", "Rendering", "AST", "Errors", "RNG", "Limits", "Testing", "*"],
  "defaultCategory": "Other",
  "navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "hideGenerator": true,
  "treatWarningsAsErrors": true,
  "customCss": "site/typedoc.css",
  "customJs": "site/typedoc.js",
  "navigationLinks": {
    "Playground": "https://roll-parser.edloidas.io/",
    "Guide": "https://roll-parser.edloidas.io/reference",
    "GitHub": "https://github.com/edloidas/roll-parser"
  }
}
